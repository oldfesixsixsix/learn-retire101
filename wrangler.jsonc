{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "retirement-planning-101",
  "main": "worker.js",
  "compatibility_date": "2026-10-18",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "BASE_PATH": ""
  },

  "env": {
    // ───────── 正式環境：unclereal.com/library/retire101（見 docs/adr/0001） ─────────
    "production": {
      "name": "retirement-planning-101",
      "routes": [
        { "pattern": "unclereal.com/library/retire101*", "zone_name": "unclereal.com" }
      ],
      "vars": {
        "BASE_PATH": "/library/retire101"
      }
    }
  }
}
